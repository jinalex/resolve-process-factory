  "collections": [
    {
      "key": "people",
      "item": "person",
      "unknown_when_empty": "who the identified individuals are",
      "empty_ok_when": {
        "fact": "excluded",
        "is": "yes"
      },
      "sop": "3.2, 3.3",
      "text": "For every other entity, identify one control person: a single individual with significant responsibility to control, manage or direct the entity. Unless the entity is excluded or is a nonprofit, identify every individual who owns 25% or more of the entity, directly or indirectly. Ownership is complete only when no unidentified person could own 25% or more, given the shares that are unaccounted for or held through entities whose owners are unknown. If an excluded entity owns 25% or more, no individual needs to be identified for that share. If ownership is not complete, request documents.",
      "counts_when": {
        "any": [
          {
            "fact": "listed",
            "is": "yes"
          },
          {
            "all": [
              {
                "fact": "excluded",
                "is": "no"
              },
              {
                "fact": "control_person",
                "is": "yes"
              }
            ]
          },
          {
            "all": [
              {
                "fact": "excluded",
                "is": "no"
              },
              {
                "fact": "nonprofit",
                "is": "no"
              },
              {
                "any": [
                  {
                    "fact": "certified_pct",
                    "at_least": 25
                  },
                  {
                    "sum": [
                      {
                        "fact": "share_pct"
                      },
                      {
                        "computed": "unidentified_pct"
                      }
                    ],
                    "at_least": 25
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "key": "excluded_owners",
      "item": "excluded entity"
