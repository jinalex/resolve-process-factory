# Live cases use real companies and people. Keep them out of the repo and the public page.
cases/live/
# Recorded runs of live cases, for the same reason.
runs/live/
node_modules/
# What the pane reads, written by pnpm resolve. Rewritten on every run.
.resolve/
# The plugin API types Claude Code writes beside a mod it loads. Rewritten on every load.
mod/resolve/.claude-plugin/types/
# One file a run, as bench/run.ts writes them; the repo keeps them packed (pnpm ladder --pack).
bench/runs/ladder/*/
